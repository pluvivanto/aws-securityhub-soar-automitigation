{
  "name": "sechub-remediation-lambdas",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome format --write src/"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "biome check --fix",
      "biome format --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-securityhub": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.4",
    "lint-staged": "^16.4.0",
    "typescript": "^5.7.0"
  }
}
