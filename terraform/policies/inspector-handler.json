{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ssm:DescribeInstanceInformation",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:${partition}:ssm:${region}::document/AWS-RunPatchBaseline",
        "arn:${partition}:ec2:${region}:${account_id}:instance/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "${sns_topic_arn}"
    },
    {
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "${inspector_queue_arn}"
    },
    {
      "Effect": "Allow",
      "Action": ["securityhub:BatchUpdateFindings", "securityhub:GetFindings"],
      "Resource": "arn:${partition}:securityhub:${region}:${account_id}:hub/default"
    },
    {
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:DeleteItem", "dynamodb:GetItem", "dynamodb:UpdateItem"],
      "Resource": "${lock_table_arn}"
    }
  ]
}